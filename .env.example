# 環境變數範例
#
# 複製為 .env 後填入實際值：
#
#     cp .env.example .env
#
# ⚠️ Spring Boot 不會自動讀取 .env 檔案，必須先載入到環境變數再啟動：
#
#     set -a && source .env && set +a
#     cd Backend && ./mvnw spring-boot:run
#
# .env 已列入 .gitignore，不會進版控。


# ── 資料庫 ────────────────────────────────────────────────
# 未設定時的預設值：使用者 root、密碼空字串。
# 若你的 MySQL root 有密碼，這裡是唯一需要改的地方。
DB_USERNAME=root
DB_PASSWORD=


# ── JWT 簽章金鑰 ──────────────────────────────────────────
# 留空也能啟動：程式會改用啟動時隨機產生的金鑰，並在日誌印出提醒。
# 代價僅是「重新啟動後先前簽發的憑證失效，需要重新登入一次」。
#
# 想讓憑證跨重啟有效，自行產生一把（HS256 需至少 32 位元組）：
#
#     openssl rand -base64 48
#
# 刻意不在此填入預設金鑰：HS256 是對稱演算法，簽發與驗證用同一把。
# 金鑰一旦進版控，任何拿到原始碼的人都能自行簽出合法憑證、冒充任意使用者。
APP_JWT_SECRET=
